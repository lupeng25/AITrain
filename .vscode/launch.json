{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug AITrainStudio",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-vscode/bin/AITrainStudio.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "Build AITrain"
    },
    {
      "name": "Debug Worker",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-vscode/bin/aitrain_worker.exe",
      "args": [
        "--server",
        "manual_debug_server"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "Build AITrain"
    }
  ]
}
