{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug AITrainStudio",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-vscode/bin/AITrainStudio.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "QT_PLUGIN_PATH",
          "value": "${workspaceFolder}\\build-vscode\\bin"
        },
        {
          "name": "QT_QPA_PLATFORM_PLUGIN_PATH",
          "value": "${workspaceFolder}\\build-vscode\\bin\\platforms"
        },
        {
          "name": "QT_QPA_PLATFORM",
          "value": "windows"
        }
      ],
      "console": "integratedTerminal",
      "preLaunchTask": "Build AITrain"
    },
    {
      "name": "Debug Worker",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-vscode/bin/aitrain_worker.exe",
      "args": [
        "--server",
        "manual_debug_server"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "QT_PLUGIN_PATH",
          "value": "${workspaceFolder}\\build-vscode\\bin"
        },
        {
          "name": "QT_QPA_PLATFORM_PLUGIN_PATH",
          "value": "${workspaceFolder}\\build-vscode\\bin\\platforms"
        },
        {
          "name": "QT_QPA_PLATFORM",
          "value": "windows"
        }
      ],
      "console": "integratedTerminal",
      "preLaunchTask": "Build AITrain"
    }
  ]
}
