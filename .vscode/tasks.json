{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure AITrain",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\vscode-task.ps1",
        "-Action",
        "Configure"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build AITrain",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\vscode-task.ps1",
        "-Action",
        "Build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Configure AITrain",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Test AITrain",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\vscode-task.ps1",
        "-Action",
        "Test"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "QT_QPA_PLATFORM": "offscreen"
        }
      },
      "dependsOn": "Build AITrain",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Run AITrain",
      "type": "shell",
      "command": "${workspaceFolder}\\build-vscode\\bin\\AITrainStudio.exe",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Build AITrain",
      "problemMatcher": []
    },
    {
      "label": "Harness Context",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\harness-context.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Encoding Check",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\encoding-check.ps1",
        "-IncludeUntracked"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Harness Check",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\harness-check.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": "$msCompile"
    }
  ]
}
